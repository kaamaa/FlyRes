{
  "name": "symfony/framework-standard-edition",
  "license": "MIT",
  "type": "project",
  "description": "The \"Symfony Standard Edition\" distribution",
  "require": {
    "php": ">=8.4",
    "symfony/framework-bundle": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/yaml": "^8.1",
    "symfony/form": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/translation": "^8.1",
    "symfony/twig-bundle": "^8.1",
    "twig/twig": "^3.8",
    "twig/extra-bundle": "^3.8",
    "symfony/asset": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/security-csrf": "^8.1",
    "symfony/security-http": "^8.1",
    "symfony/security-core": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/http-foundation": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/event-dispatcher": "^8.1",
    "symfony/filesystem": "^8.1",
    "symfony/finder": "^8.1",
    "symfony/cache": "^8.1",
    "symfony/config": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/error-handler": "^8.1",
    "symfony/mailer": "^8.1",
    "symfony/mime": "^8.1",
    "symfony/options-resolver": "^8.1",
    "symfony/password-hasher": "^8.1",
    "symfony/property-access": "^8.1",
    "symfony/property-info": "^8.1",
    "symfony/stopwatch": "^8.1",
    "symfony/string": "^8.1",
    "symfony/var-dumper": "^8.1",
    "symfony/var-exporter": "^8.1",

    "doctrine/orm": "^3.0",
    "doctrine/dbal": "^4.0",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/annotations": "^1.14 || ^2.0",
    "symfony/apache-pack": "^1.0",
    "symfony/flex": "^2.8",
    "symfony/monolog-bundle": "^4.0",
    "symfony/rate-limiter": "^8.1"
  },
  "require-dev": {
    "symfony/phpunit-bridge": "^8.1",
    "symfony/web-profiler-bundle": "^8.1",
    "symfony/maker-bundle": "^1.60",
    "phpunit/phpunit": "^10.5",
    "rector/rector": "^2.5"
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "autoload": {
    "psr-4": { "App\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "App\\Tests\\": "tests/" }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true
    },
    "platform": {
      "php": "8.4.1"
    }
  },
  "extra": {
    "symfony": {
      "require": "^8.1"
    }
  }
}
