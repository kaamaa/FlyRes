{% extends "layout.html.twig" %}

{% block content %}
<div style="margin:14px;max-width:620px;">
  <h2 style="color:#186FA3;margin-top:6px;">
    {% if isNew %}Neuer Mandant{% else %}Mandant bearbeiten — {{ client.name }}{% endif %}
  </h2>

  <form method="POST"
        action="{% if isNew %}{{ path('_config_mandant_create') }}{% else %}{{ path('_config_mandant_save', {id: client.id}) }}{% endif %}">
    <input type="hidden" name="_token" value="{{ csrf_token('mandant') }}">

    <div class="row">
      <div class="col-sm-8 form-group"><label>Name der Flugschule</label>
        <input class="form-control" name="name" value="{{ client.name }}" required></div>
      <div class="col-sm-4 form-group"><label>Status</label>
        <div class="checkbox" style="margin-top:4px;">
          <label><input type="checkbox" name="active" value="1" {% if client.active %}checked{% endif %}> aktiv</label>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-4 form-group"><label>Vorausschau „Nächste freie Termine"</label>
        <div class="input-group">
          <input type="number" class="form-control" name="nextslots_days" min="1" max="120"
                 value="{{ isNew ? 14 : client.nextslotsDays }}" required>
          <span class="input-group-addon">Tage</span>
        </div>
        <span class="help-block" style="font-size:12px;">Wie viele Tage die Terminsuche im Reservieren vorausschaut (1–120, Standard 14).</span>
      </div>
    </div>

    <p style="margin-top:10px;">
      <button type="submit" class="btn btn-primary">Speichern</button>
      <a href="{{ path('_config_mandanten') }}" class="btn btn-default">Abbrechen</a>
    </p>
  </form>
</div>
{% endblock %}
