{# E-Mail-sicheres HTML (Tabellen + Inline-Styles, keine SVG/Verlaeufe/Flexbox),
   damit es in Outlook/Gmail/Apple Mail zuverlaessig aussieht. #}
{% import _self as m %}

{% macro row(label, val, oldval) %}
  <tr>
    <td style="padding:9px 0;border-bottom:1px solid #e6ebf1;color:#6b7888;font-size:14px;vertical-align:top;width:42%;">{{ label }}</td>
    <td style="padding:9px 0;border-bottom:1px solid #e6ebf1;color:#1d2733;font-size:14px;font-weight:bold;vertical-align:top;">
      {{ val|default('—') }}
      {%- if oldval is not empty and oldval != val %}
        <span style="background:#fbf1df;color:#b7791f;font-size:10px;font-weight:bold;text-transform:uppercase;padding:1px 6px;border-radius:5px;">geändert</span>
        <span style="color:#6b7888;text-decoration:line-through;font-weight:normal;font-size:12px;">{{ oldval }}</span>
      {%- endif %}
    </td>
  </tr>
{% endmacro %}

{% set tl = type|lower %}
{% set statuscolor = ('stornier' in tl or 'lösch' in tl or 'geloescht' in tl) ? '#c9453b'
                  : (('änder' in tl or 'geänder' in tl or 'aktualis' in tl) ? '#b7791f' : '#2e7d46') %}
{% set status = (statuscolor == '#c9453b') ? 'Storniert' : ((statuscolor == '#b7791f') ? 'Geändert' : 'Neu') %}
{% set subline = (statuscolor == '#c9453b') ? 'Diese Reservierung wurde storniert.'
              : ((statuscolor == '#b7791f') ? 'Diese Reservierung wurde geändert – geänderte Werte sind markiert.'
              : 'Diese Reservierung wurde neu angelegt.') %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;">
 <tr><td align="center" style="padding:0;">
  <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;background:#ffffff;">

   <tr><td bgcolor="#1f6fb2" style="background:#1f6fb2;padding:18px 24px;">
     <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
       <td style="color:#ffffff;font-weight:bold;font-size:16px;line-height:1.3;">Flugschule Worms<br><span style="font-weight:normal;font-size:11px;color:#cfe0f1;">Reservierungssystem</span></td>
       <td align="right" style="vertical-align:middle;"><span style="background:{{ statuscolor }};color:#ffffff;font-size:11px;font-weight:bold;text-transform:uppercase;letter-spacing:.5px;padding:5px 12px;border-radius:20px;">{{ status }}</span></td>
     </tr></table>
   </td></tr>

   <tr><td style="padding:22px 24px;">
     <div style="font-size:18px;font-weight:bold;color:#1d2733;">{{ type }}</div>
     <div style="font-size:13px;color:#6b7888;padding:2px 0 16px;">{{ subline }}</div>

     <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
       {{ m.row('Reserviert für', primary_ReservedForUser, secondary_ReservedForUser|default('')) }}
       {{ m.row('Beginn', primary_start, secondary_start|default('')) }}
       {{ m.row('Ende', primary_end, secondary_end|default('')) }}
       {{ m.row('Flugzeug', primary_flugzeug, secondary_flugzeug|default('')) }}
       {% if primary_flightinstructor is defined and primary_flightinstructor != '' %}
         {{ m.row('Fluglehrer', primary_flightinstructor, secondary_flightinstructor|default('')) }}
       {% endif %}
       {{ m.row('Zielflugplatz', primary_airfield, secondary_airfield|default('')) }}
       {{ m.row('Flugzweck', primary_flightpurpose, secondary_flightpurpose|default('')) }}
       {{ m.row('Beschreibung', primary_description, secondary_description|default('')) }}
     </table>

     {% if (primary_EmailInfoIntern|default('')) is not empty or (primary_EmailInfoExtern|default('')) is not empty %}
     <div style="margin-top:16px;padding-top:14px;border-top:1px solid #e6ebf1;font-size:12px;color:#6b7888;line-height:1.6;">
       <b style="color:#1d2733;">Informiert wurde(n):</b><br>
       Intern: {{ primary_EmailInfoIntern|default('—') }}<br>
       Extern: {{ primary_EmailInfoExtern|default('—') }}
     </div>
     {% endif %}
   </td></tr>

   <tr><td bgcolor="#f7f9fc" style="background:#f7f9fc;border-top:1px solid #e6ebf1;padding:16px 24px;color:#6b7888;font-size:12px;line-height:1.7;">
     <b style="color:#1d2733;">Aero-Service-Worms GmbH</b> &middot; Am Flugplatz 3 &middot; 67547 Worms<br>
     Tel. +49&nbsp;6241&nbsp;207333 &middot; info@flugschule-worms.de &middot; www.flugschule-worms.de<br>
     <span style="color:#aeb6c1;">Automatische Nachricht aus dem Reservierungssystem – bitte nicht direkt antworten.</span>
   </td></tr>

  </table>
 </td></tr>
</table>
