{# E-Mail-sicheres HTML (Tabellen + Inline-Styles), analog zur Reservierungs-Mail. #}
{% import _self as m %}

{% macro row(label, val, oldval) %}
  <tr>
    <td style="padding:9px 0;border-bottom:1px solid #e6ebf1;color:#6b7888;font-size:14px;vertical-align:top;width:42%;">{{ label }}</td>
    <td style="padding:9px 0;border-bottom:1px solid #e6ebf1;color:#1d2733;font-size:14px;font-weight:bold;vertical-align:top;">
      {{ val|default('—') }}
      {%- if oldval is not empty and oldval != val %}
        <span style="background:#fbf1df;color:#b7791f;font-size:10px;font-weight:bold;text-transform:uppercase;padding:1px 6px;border-radius:5px;">geändert</span>
        <span style="color:#6b7888;text-decoration:line-through;font-weight:normal;font-size:12px;">{{ oldval }}</span>
      {%- endif %}
    </td>
  </tr>
{% endmacro %}

{% set tl = type|lower %}
{% set statuscolor = ('lösch' in tl or 'geloescht' in tl or 'stornier' in tl) ? '#c9453b'
                  : (('änder' in tl or 'geänder' in tl or 'aktualis' in tl) ? '#b7791f' : '#2e7d46') %}
{% set status = (statuscolor == '#c9453b') ? 'Gelöscht' : ((statuscolor == '#b7791f') ? 'Geändert' : 'Neu') %}
{% set subline = (statuscolor == '#c9453b') ? 'Diese Berechtigung wurde gelöscht.'
              : ((statuscolor == '#b7791f') ? 'Diese Berechtigung wurde geändert – geänderte Werte sind markiert.'
              : 'Diese Berechtigung wurde neu angelegt.') %}
{% set unlimited = 'Ja' in (primary_Unlimited|default('')) %}

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#eef1f5;margin:0;padding:24px 0;font-family:Arial,Helvetica,sans-serif;">
 <tr><td align="center">
  <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;background:#ffffff;border-radius:12px;">

   <tr><td bgcolor="#1f6fb2" style="background:#1f6fb2;padding:16px 24px;border-radius:12px 12px 0 0;">
     <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
       <td style="color:#ffffff;font-weight:bold;font-size:16px;line-height:1.3;">Flugschule Worms<br><span style="font-weight:normal;font-size:11px;color:#cfe0f1;">Berechtigungen</span></td>
       <td align="right" style="vertical-align:middle;"><span style="background:{{ statuscolor }};color:#ffffff;font-size:11px;font-weight:bold;text-transform:uppercase;letter-spacing:.5px;padding:5px 12px;border-radius:20px;">{{ status }}</span></td>
     </tr></table>
   </td></tr>

   <tr><td style="padding:22px 24px;">
     <div style="font-size:18px;font-weight:bold;color:#1d2733;">{{ type }}</div>
     <div style="font-size:13px;color:#6b7888;padding:2px 0 16px;">{{ subline }}</div>

     <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
       {{ m.row('Berechtigung für', primary_Username, secondary_Username|default('')) }}
       {{ m.row('Berechtigung', primary_Licence, secondary_Licence|default('')) }}
       {{ m.row('Unbegrenzt gültig', primary_Unlimited, secondary_Unlimited|default('')) }}
       <tr>
         <td style="padding:9px 0;border-bottom:1px solid #e6ebf1;color:#6b7888;font-size:14px;vertical-align:top;width:42%;">Gültig bis</td>
         <td style="padding:9px 0;border-bottom:1px solid #e6ebf1;color:#1d2733;font-size:14px;font-weight:bold;vertical-align:top;">
           {% if unlimited %}
             <span style="color:#6b7888;font-weight:normal;text-decoration:line-through;">{{ primary_ValidUntil|default('—') }}</span>
             <span style="color:#6b7888;font-weight:normal;">&nbsp;(unbegrenzt gültig)</span>
           {% else %}
             {{ primary_ValidUntil|default('—') }}
             {%- if secondary_ValidUntil is defined and secondary_ValidUntil != primary_ValidUntil %}
               <span style="background:#fbf1df;color:#b7791f;font-size:10px;font-weight:bold;text-transform:uppercase;padding:1px 6px;border-radius:5px;">geändert</span>
               <span style="color:#6b7888;text-decoration:line-through;font-weight:normal;font-size:12px;">{{ secondary_ValidUntil }}</span>
             {%- endif %}
           {% endif %}
         </td>
       </tr>
       {{ m.row('Kommentar', primary_description, secondary_description|default('')) }}
       {{ m.row('Geändert von', primary_ChangedBy, secondary_ChangedBy|default('')) }}
       {{ m.row('Geändert am', primary_ChangedAt, secondary_ChangedAt|default('')) }}
     </table>
   </td></tr>

   <tr><td bgcolor="#f7f9fc" style="background:#f7f9fc;border-top:1px solid #e6ebf1;padding:16px 24px;color:#6b7888;font-size:12px;line-height:1.7;border-radius:0 0 12px 12px;">
     <b style="color:#1d2733;">Aero-Service-Worms GmbH</b> &middot; Am Flugplatz 3 &middot; 67547 Worms<br>
     Tel. +49&nbsp;6241&nbsp;207333 &middot; info@flugschule-worms.de &middot; www.flugschule-worms.de<br>
     <span style="color:#aeb6c1;">Automatische Nachricht aus dem Reservierungssystem – bitte nicht direkt antworten.</span>
   </td></tr>

  </table>
 </td></tr>
</table>
