{% extends "layout.html.twig" %}

{% block content %}
  <style>
    .group-header-1 {
      background-color: #d1e7ff !important;
      color: #0a3d80 !important;
      font-size: 1.1em;
      font-weight: bold;
      padding: 8px !important;
    }
    .group-header-2 {
      background-color: #e9ecef !important;
      color: #495057 !important;
      font-weight: 600;
      padding: 6px 8px !important;
    }
  </style>
  <div class="gv">
    <div class="table-responsive" style="max-width:570px;">
      <table class="table table-sm table-striped table-hover align-middle mb-0 border" cellspacing="1" cellpadding="4">
        {% set group1  = '' %}
        {% set group2  = '' %}

        {# ------------------------------------------------------------
           A) Standard-Ansichten (Datum -> Flugzeug -> Zeilen)
           ------------------------------------------------------------ #}
        {% if command in ['own','own_history','date','today','tomorrow','thisweek','weekafter','thisweekend','nextweekend','training'] %}
          {% for booking in bookings %}
            {% if group1 != booking.date %}
              {% set group1  = booking.date %}
              <tr class="group-header-1">
                <td colspan="4"><strong>{{ booking.date }}</strong></td>
                {% set group2  = '' %}
              </tr>
            {% endif %}

            {% if group2 != booking.flugzeug %}
              {% set group2  = booking.flugzeug %}
              <tr class="group-header-2">
                <td colspan="4">{{ booking.flugzeug }}</td>
              </tr>
            {% endif %}

            <tr>
              <td class="text-nowrap">
                <form action="{{ path('_viewbookingdetails') }}" name="form{{ booking.random }}" method="POST">
                  <input type="hidden" name="ts" value="{{ booking.bookingid }}">
                  <a href="javascript:document.form{{ booking.random }}.submit();" class="btn btn-primary btn-sm">
                    {{ booking.start }} - {{ booking.end }}
                  </a>
                </form>
              </td>
              <td>{{ booking.user }}</td>
              <td>
                {{ booking.flightpurpose }}
                {% if booking.isflighttraining == TRUE %}
                  <br><span class="badge bg-warning text-dark">FI: {{ booking.flightinstructor }}</span>
                {% endif %}
              </td>
              <td>{{ booking.description }}</td>
            </tr>
          {% endfor %}
        {% endif %}

        {# ------------------------------------------------------------
           B) Nach Fluglehrer (FI -> Datum -> Zeilen)
           ------------------------------------------------------------ #}
        {% if command in ['fi'] %}
          {% for booking in bookings %}
            {% if group1 != booking.flightinstructor %}
              {% set group1  = booking.flightinstructor %}
              <tr class="group-header-1">
                <td colspan="5"><strong>{{ booking.flightinstructor }}</strong></td>
                {% set group2  = '' %}
              </tr>
            {% endif %}

            {% if group2 != booking.date %}
              {% set group2  = booking.date %}
              <tr class="group-header-2">
                <td colspan="5">{{ booking.date }}</td>
              </tr>
            {% endif %}

            <tr>
              <td class="text-nowrap">
                <form novalidate="true" action="{{ path('_viewbookingdetails') }}" name="form{{ booking.random }}" method="POST">
                  <input type="hidden" name="ts" value="{{ booking.bookingid }}">
                  <a href="javascript:document.form{{ booking.random }}.submit();" class="btn btn-primary btn-sm">
                    {{ booking.start }} - {{ booking.end }}
                  </a>
                </form>
              </td>
              <td>{{ booking.flugzeug }}</td>
              <td>{{ booking.user }}</td>
              <td>{{ booking.flightpurpose }}</td>
              <td>{{ booking.description }}</td>
            </tr>
          {% endfor %}
        {% endif %}

        {# ------------------------------------------------------------
           C) Nach Flugzeugen (Flugzeug -> Datum -> Zeilen)
           ------------------------------------------------------------ #}
        {% if command in ['planes'] %}
          {% for booking in bookings %}
            {% if group1 != booking.flugzeug %}
              {% set group1  = booking.flugzeug %}
              <tr class="group-header-1">
                <td colspan="4"><strong>{{ booking.flugzeug }}</strong></td>
                {% set group2  = '' %}
              </tr>
            {% endif %}

            {% if group2 != booking.date %}
              {% set group2  = booking.date %}
              <tr class="group-header-2">
                <td colspan="4">{{ booking.date }}</td>
              </tr>
            {% endif %}

            <tr>
              <td class="text-nowrap">
                <form novalidate="true" action="{{ path('_viewbookingdetails') }}" name="form{{ booking.random }}" method="POST">
                  <input type="hidden" name="ts" value="{{ booking.bookingid }}">
                  <a href="javascript:document.form{{ booking.random }}.submit();" class="btn btn-primary btn-sm">
                    {{ booking.start }} - {{ booking.end }}
                  </a>
                </form>
              </td>
              <td>{{ booking.user }}</td>
              <td>
                {{ booking.flightpurpose }}
                {% if booking.isflighttraining == TRUE %}
                  <br><span class="badge bg-warning text-dark">FI: {{ booking.flightinstructor }}</span>
                {% endif %}
              </td>
              <td>{{ booking.description }}</td>
            </tr>
          {% endfor %}
        {% endif %}

        {# ------------------------------------------------------------
           D) Nach Benutzern (User -> Datum -> Zeilen)
           ------------------------------------------------------------ #}
        {% if command in ['users'] %}
          {% for booking in bookings %}
            {% if group1 != booking.user %}
              {% set group1  = booking.user %}
              <tr class="group-header-1">
                <td colspan="4"><strong>{{ booking.user }}</strong></td>
                {% set group2  = '' %}
              </tr>
            {% endif %}

            {% if group2 != booking.date %}
              {% set group2  = booking.date %}
              <tr class="group-header-2">
                <td colspan="4">{{ booking.date }}</td>
              </tr>
            {% endif %}

            <tr>
              <td class="text-nowrap">
                <form novalidate="true" action="{{ path('_viewbookingdetails') }}" name="form{{ booking.random }}" method="POST">
                  <input type="hidden" name="ts" value="{{ booking.bookingid }}">
                  <a href="javascript:document.form{{ booking.random }}.submit();" class="btn btn-primary btn-sm">
                    {{ booking.start }} - {{ booking.end }}
                  </a>
                </form>
              </td>
              <td>{{ booking.flugzeug }}</td>
              <td>
                {{ booking.flightpurpose }}
                {% if booking.isflighttraining == TRUE %}
                  <br><span class="badge bg-warning text-dark">FI: {{ booking.flightinstructor }}</span>
                {% endif %}
              </td>
              <td>{{ booking.description }}</td>
            </tr>
          {% endfor %}
        {% endif %}
      </table>
    </div>
  </div>
{% endblock %}
