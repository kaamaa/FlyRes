  <body>
    <script type="application/javascript" src="{{asset('images/js/wz_tooltip.js')}}"></script>
    <script type="application/javascript" src="{{asset('bootstrap/dist/js/jquery.min.js') }}"></script>
    <script type="application/javascript" src="{{asset('bootstrap/dist/js/bootstrap.min.js') }}"></script> 
    <script type="application/javascript" src="{{asset('bootstrap-datetimepicker/js/bootstrap-datetimepicker.min.js') }}"></script> 
    <script type="application/javascript"  src="{{asset('bootstrap-datetimepicker/js/locales/bootstrap-datetimepicker.de.js') }}"></script> 
   
    
    <div class="inhalt"> 
      
      {# zunächst prüfen, ob die Sitzung des Nutzers nicht schon abgelaufen ist und kein Token mehr existiert #}
      {% if app.token is not null %}
        {% block left %}
           {{ render(controller('App\\Controller\\MenuViewController::ViewAction')) }}
        {% endblock %}
      {% endif %}  
      
      {# Gäste dürfen von Flyres nichts sehen aus dem Menü #}
      {% if app.token is not null and app.user is not null and is_granted('ROLE_PILOT') %}
        {% block content %}
        {% endblock %} 
      
        
        {% block bottom %}
          {# die Lizenzen nur anzeigen, wenn Buchunngen aufgelistet oder eine neue Buchung eingetragen wird #}
          {% set spath = app.request.attributes.get('_route') %}
          {% if spath is defined %}
              {% if 'weeksview' in spath or 'monthview' in spath or 'newbooking' in spath or 'generalview' in spath or 'savebooking' in spath%}
                  <br><br>
                  {{ render(controller('App\\Controller\\NoteController::ViewNotesAction'))}}
                  <br><br>
                  {{ render(controller('App\\Controller\\LicenceController::GridAction',{'standalone': false})) }}
              {% endif %}
          {% endif %}
        {% endblock %}
      {% endif %}  
    </div>
    <br>

    {# Auto-Hoehe: meldet die Inhaltshoehe an das einbettende iframe (Joomla-Modul mod_flyreslogin).
       Misst gezielt den Inhaltscontainer ".inhalt" -> schliesst absolut positionierte
       Offscreen-Elemente aus (z.B. das ausgeklappte cssplay-Menue mit left:-9999px),
       die sonst scrollHeight kuenstlich aufblaehen. Fallback auf Standardmessung. #}
    <script>
    (function () {
        if (window.parent === window) { return; }   // nur wenn im iframe eingebettet

        var last = 0;
        var RESERVE = 8;   // kleine Reserve fuer abschliessende Abstaende

        function fallbackHeight() {
            var b = document.body, e = document.documentElement;
            return Math.max(
                b ? b.scrollHeight : 0, b ? b.offsetHeight : 0,
                e ? e.scrollHeight : 0, e ? e.offsetHeight : 0
            );
        }

        function measure() {
            var off = window.pageYOffset || (document.documentElement ? document.documentElement.scrollTop : 0) || 0;

            // Bevorzugt den eigentlichen Inhaltscontainer messen.
            var c = document.querySelector('.inhalt');
            if (c) {
                var h = c.getBoundingClientRect().bottom + off;
                if (h > 50) { return Math.ceil(h + RESERVE); }
            }

            return Math.ceil(fallbackHeight());
        }

        function send() {
            var v = measure();
            if (v > 0 && Math.abs(v - last) > 2) {
                last = v;
                window.parent.postMessage({ flyresHeight: v }, '*');
            }
        }

        function init() {
            send();
            if (window.ResizeObserver) {
                try {
                    var ro = new ResizeObserver(send);
                    ro.observe(document.documentElement);
                    if (document.body) { ro.observe(document.body); }
                    var c = document.querySelector('.inhalt');
                    if (c) { ro.observe(c); }
                } catch (e) {}
            }
            if (window.MutationObserver && document.body) {
                try {
                    new MutationObserver(send).observe(document.body, {
                        childList: true, subtree: true, attributes: true, characterData: true
                    });
                } catch (e) {}
            }
            var imgs = document.images || [];
            for (var i = 0; i < imgs.length; i++) {
                if (!imgs[i].complete) { imgs[i].addEventListener('load', send); }
            }
            setInterval(send, 1000);
        }

        window.addEventListener('resize', send);
        window.addEventListener('load', send);
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
    </script>
  </body>
</html>