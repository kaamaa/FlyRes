{% extends 'modern/layout.html.twig' %}

{% block ptitle %}Schulungszeiten{% endblock %}

{% block topactions %}
  {% if isAdmin and isFi %}
    <a class="fr-chip {{ scope == 'meine' ? 'on' : '' }}" href="{{ path('modern_fiavail') }}">Meine</a>
    <a class="fr-chip {{ scope == 'alle' ? 'on' : '' }}" href="{{ path('modern_fiavail', {scope: 'alle'}) }}">Alle Fluglehrer</a>
  {% endif %}
  <a class="fr-btn ghost" style="margin-left:auto;" href="{{ path('modern_fiavail_bulk') }}">Mehrere löschen</a>
  <a class="fr-btn ghost" href="{{ path('modern_fiavail_series') }}">Serie</a>
  <a class="fr-btn" href="{{ path('modern_fiavail_new') }}">＋ Einzeln</a>
{% endblock %}

{% block content %}
  {% if notice %}<div class="fr-msg ok">{{ notice }}</div>{% endif %}
  <div class="fr-fihint">
    Trage hier ein, wann du für Schulungen <b>verfügbar</b>, nur <b>auf Anfrage</b> oder <b>nicht verfügbar</b> bist.
    Über <b>Serie</b> legst du wiederkehrende Termine an (z. B. jeden Samstag); über <b>Mehrere löschen</b> entfernst du ganze Zeiträume.
  </div>

  <div class="fr-cards">
    {% for a in items %}
      <div class="fr-acard">
        <a class="fr-acard-main" href="{{ path('modern_fiavail_edit', {id: a.id}) }}">
          <span class="fr-fibar {{ a.state }}"></span>
          <div class="fr-acard-info">
            <div class="fr-acard-t">{{ a.von }} – {{ a.bis }}{% if scope == 'alle' and a.fi %} <span class="fr-acard-sub">{{ a.fi }}</span>{% endif %}</div>
            {% if a.comment %}<div class="fr-acard-meta">{{ a.comment }}</div>{% endif %}
          </div>
          <span class="fr-ltag {{ a.state }}">{{ a.typname }}</span>
          <span class="fr-lchev">›</span>
        </a>
        <form class="fr-acard-del" method="post" action="{{ path('modern_fiavail_delete') }}" onsubmit="return confirm('Diesen Eintrag löschen?');">
          <input type="hidden" name="id" value="{{ a.id }}">
          <button type="submit" class="fr-iconbtn del" title="Löschen">🗑</button>
        </form>
      </div>
    {% else %}
      <div class="fr-empty">Keine Schulungszeiten eingetragen.</div>
    {% endfor %}
  </div>

  <div class="fr-llegend">
    <span><i class="green"></i>verfügbar</span>
    <span><i class="amber"></i>auf Anfrage</span>
    <span><i class="red"></i>nicht verfügbar</span>
  </div>
{% endblock %}
