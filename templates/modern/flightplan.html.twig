{% extends 'modern/layout.html.twig' %}

{% block ptitle %}VFR-Flugplanung{% endblock %}

{% block content %}
<style>
  .fp-form{display:grid;grid-template-columns:minmax(240px,1.4fr) repeat(4,minmax(90px,1fr)) auto;gap:12px;align-items:end;}
  .fp-form label{display:block;font-size:11px;font-weight:800;color:var(--fr-blue-d);text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;}
  .fp-form textarea,.fp-form input{width:100%;padding:9px 10px;border:1px solid var(--fr-line,#d8d8d8);border-radius:8px;font:inherit;background:#fff;}
  .fp-form textarea{min-height:92px;resize:vertical;font-variant-numeric:tabular-nums;}
  .fp-hint{font-size:12px;color:var(--fr-mut);margin:6px 0 16px;}
  .fp-card{background:#fff;border:1px solid var(--fr-line,#e5e5e5);border-radius:12px;padding:14px 16px;margin-top:16px;overflow-x:auto;}
  .fp-sec{font-size:11px;font-weight:800;color:var(--fr-blue-d);text-transform:uppercase;letter-spacing:.5px;margin:0 0 8px;}
  table.fp{border-collapse:collapse;width:100%;font-size:13px;}
  table.fp th,table.fp td{padding:7px 10px;border-bottom:1px solid var(--fr-line);text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums;}
  table.fp th{font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--fr-mut);border-bottom:2px solid var(--fr-line);}
  table.fp td.l,table.fp th.l{text-align:left;}
  table.fp tr.tot td{font-weight:800;border-top:2px solid var(--fr-line);border-bottom:none;background:#f6f9fc;}
  table.fp tr.err td{color:var(--fr-red,#c9453b);}
  .fp-badge{display:inline-block;font-size:11px;font-weight:700;padding:1px 7px;border-radius:20px;}
  .fp-ok{background:#eef7f0;color:var(--fr-green);}
  .fp-bad{background:#fbeeec;color:var(--fr-red,#c9453b);}
  .fp-disc{font-size:11.5px;color:var(--fr-mut);margin-top:14px;border-top:1px dashed var(--fr-line);padding-top:8px;}
</style>

<form method="post" action="{{ path('modern_flightplan') }}">
  <div class="fp-form">
    <div>
      <label for="fp-route">Route (ICAO je Zeile)</label>
      <textarea id="fp-route" name="route" placeholder="EDFV&#10;EDFZ&#10;EDFM">{{ routeText }}</textarea>
    </div>
    <div><label>TAS (kt)</label><input type="number" name="tas" value="{{ tas|round }}" min="1" step="1"></div>
    <div><label>Wind aus (°)</label><input type="number" name="wind_dir" value="{{ windDir|round }}" min="0" max="360" step="1"></div>
    <div><label>Wind (kt)</label><input type="number" name="wind_speed" value="{{ windSpeed|round }}" min="0" step="1"></div>
    <div><label>Verbrauch (l/h)</label><input type="number" name="fuel_rate" value="{{ fuelRate|round(1) }}" min="0" step="0.5"></div>
    <div><button type="submit" class="fr-btn">Berechnen</button></div>
  </div>
</form>
<div class="fp-hint">Wegpunkte als ICAO-Code (z. B. <span class="sys-mono">EDFV</span>) – eine je Zeile oder durch Leerzeichen/Komma getrennt. Daten aus der Nav-Datenbank (Flugplätze &amp; Waypoints).</div>

{% if points is not empty %}
<div class="fp-card">
  <div class="fp-sec">Wegpunkte</div>
  <table class="fp">
    <tr><th class="l">ICAO</th><th class="l">Name</th><th>gefunden</th></tr>
    {% for p in points %}
      <tr>
        <td class="l"><b>{{ p.input }}</b></td>
        <td class="l">{{ p.name ?? '—' }}</td>
        <td>{% if p.found %}<span class="fp-badge fp-ok">✓</span>{% else %}<span class="fp-badge fp-bad">nicht gefunden</span>{% endif %}</td>
      </tr>
    {% endfor %}
  </table>
</div>

{% if legs is not empty %}
<div class="fp-card">
  <div class="fp-sec">Navigations-Log</div>
  <table class="fp">
    <tr>
      <th class="l">Von</th><th class="l">Nach</th>
      <th>Distanz</th><th>Kurs TC</th><th>Steuerkurs TH</th><th>GS</th><th>Zeit</th><th>Sprit</th>
    </tr>
    {% for leg in legs %}
      {% if leg.error %}
        <tr class="err">
          <td class="l"><b>{{ leg.from }}</b></td><td class="l"><b>{{ leg.to }}</b></td>
          <td>{{ leg.dist is defined ? (leg.dist|round(1)) ~ ' NM' : '' }}</td>
          <td>{{ leg.tc is defined ? '%03d°'|format(leg.tc|round) : '' }}</td>
          <td colspan="4" class="l">⚠ {{ leg.error }}</td>
        </tr>
      {% else %}
        <tr>
          <td class="l"><b>{{ leg.from }}</b></td><td class="l"><b>{{ leg.to }}</b></td>
          <td>{{ leg.dist|round(1) }} NM</td>
          <td>{{ '%03d°'|format(leg.tc|round) }}</td>
          <td>{{ '%03d°'|format(leg.th|round) }}</td>
          <td>{{ leg.gs|round }} kt</td>
          <td>{{ leg.timeStr }}</td>
          <td>{{ leg.fuel|round(1) }} l</td>
        </tr>
      {% endif %}
    {% endfor %}
    <tr class="tot">
      <td class="l" colspan="2">Gesamt{% if not ok %} <span class="fp-badge fp-bad">unvollständig</span>{% endif %}</td>
      <td>{{ totDist|round(1) }} NM</td>
      <td></td><td></td><td></td>
      <td>{{ totTimeStr }}</td>
      <td>{{ totFuel|round(1) }} l</td>
    </tr>
  </table>
  <div class="fp-disc">
    <b>Achtung:</b> Die verwendeten Navigationsdaten sind nicht auf dem aktuellen Stand. Ergebnisse vor Flugantritt anhand der offiziell gültigen Unterlagen (AIP, ICAO-Karten, Flughandbuch) überprüfen. Benutzung auf eigene Gefahr.
  </div>
</div>
{% endif %}
{% endif %}
{% endblock %}
