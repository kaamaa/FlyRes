{% extends 'modern/layout.html.twig' %}

{% block ptitle %}Weight &amp; Balance{% endblock %}

{% block topactions %}
  <button type="button" class="fr-btn ghost" onclick="window.print()">🖨 Als PDF / drucken</button>
{% endblock %}

{% block content %}
<style>
  .wb-top{display:flex;flex-wrap:wrap;gap:12px;align-items:end;margin-bottom:14px;}
  .wb-top label{display:block;font-size:11px;font-weight:800;color:var(--fr-blue-d);text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;}
  .wb-top select,.wb-top input{padding:9px 10px;border:1px solid var(--fr-line,#d8d8d8);border-radius:8px;font:inherit;background:#fff;}
  .wb-top select{min-width:300px;} .wb-top input{width:96px;}
  .wb-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start;}
  .wb-card{background:#fff;border:1px solid var(--fr-line,#e5e5e5);border-radius:12px;padding:14px 16px;}
  table.wb{border-collapse:collapse;width:100%;font-size:13px;}
  table.wb th,table.wb td{padding:8px 9px;border-bottom:1px solid var(--fr-line);text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums;}
  table.wb th{font-size:11px;text-transform:uppercase;letter-spacing:.4px;color:var(--fr-mut);}
  table.wb td.l,table.wb th.l{text-align:left;} table.wb td.l small{color:var(--fr-mut);}
  table.wb input{width:84px;padding:6px 8px;border:1px solid var(--fr-line);border-radius:7px;font:inherit;text-align:right;}
  table.wb input.over{border-color:var(--fr-red,#c9453b);background:#fdf1ef;}
  table.wb tr.sum td{font-weight:800;border-top:2px solid var(--fr-line);background:#f6f9fc;}
  .wb-kpi{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:10px;}
  .wb-kpi .k{flex:1;min-width:110px;background:#fff;border:1px solid var(--fr-line);border-radius:12px;padding:11px 13px;}
  .wb-kpi .k.hero{background:linear-gradient(135deg,var(--fr-blue),var(--fr-blue-d));color:#fff;border:none;}
  .wb-kpi .v{font-size:23px;font-weight:800;line-height:1;} .wb-kpi .t{font-size:11px;color:var(--fr-mut);margin-top:5px;}
  .wb-kpi .k.hero .t{color:#e6eef6;}
  .verdict{display:inline-flex;align-items:center;gap:8px;font-weight:800;padding:8px 14px;border-radius:10px;font-size:15px;margin-bottom:12px;}
  .verdict.ok{background:#eaf7ef;color:var(--fr-green);} .verdict.bad{background:#fbeeec;color:var(--fr-red,#c9453b);}
  .wb-warn{list-style:none;margin:10px 0 0;padding:0;} .wb-warn li{color:var(--fr-red,#c9453b);font-size:12.5px;padding:2px 0;}
  .wb-note{font-size:11.5px;color:var(--fr-mut);margin-top:12px;border-top:1px dashed var(--fr-line);padding-top:8px;}
  .wb-src{font-size:11px;color:var(--fr-mut);margin-top:6px;}
  @media print{ .fr-side,.fr-top{display:none!important;} .fr-app,.fr-main{display:block!important;} .fr-body{padding:0!important;} .wb-grid{grid-template-columns:1fr;} .wb-card{border:none;} table.wb input{border:none;background:transparent;} }
  @media (max-width:900px){ .wb-grid{grid-template-columns:1fr;} }
</style>

<div class="wb-top">
  <div>
    <label>Flugzeugmuster ({{ aircraft|length }})</label>
    <select id="wb-ac">
      <option value="">— Muster wählen —</option>
      {% for a in aircraft %}<option value="{{ a.id }}">{{ a.label }}</option>{% endfor %}
    </select>
  </div>
  <div><label>Leermasse (kg)</label><input type="number" id="wb-em" step="0.1"></div>
  <div><label>Leerarm (m)</label><input type="number" id="wb-ea" step="0.001"></div>
  <div><label>Trip-Fuel (l)</label><input type="number" id="wb-trip" step="1" value="0"></div>
</div>

<div id="wb-body" style="display:none">
  <div class="wb-grid">
    <div class="wb-card">
      <table class="wb" id="wb-load"></table>
      <div class="wb-src" id="wb-src"></div>
    </div>
    <div>
      <div class="wb-kpi" id="wb-kpi"></div>
      <div id="wb-verdict"></div>
      <div class="wb-card" style="padding:10px"><div id="wb-env"></div></div>
      <ul class="wb-warn" id="wb-warn"></ul>
    </div>
  </div>
  <div class="wb-note"><b>Achtung:</b> Prototyp. Für den Betrieb das verifizierte AFM/Wägeblatt des konkreten Flugzeugs verwenden – Leermasse/-arm oben anpassen. Benutzung auf eigene Gefahr.</div>
</div>
<div id="wb-empty" class="wb-note">Bitte oben ein Flugzeugmuster wählen.</div>

<script>
(function () {
  var CALC_URL = '{{ path('modern_wb_calc') }}';
  var acSel = document.getElementById('wb-ac');
  var emEl = document.getElementById('wb-em'), eaEl = document.getElementById('wb-ea'), tripEl = document.getElementById('wb-trip');
  var timer = null;

  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function n1(x) { return (Math.round(x * 10) / 10).toLocaleString('de-DE'); }

  async function post(withLoad) {
    var b = new URLSearchParams();
    b.append('id', acSel.value);
    b.append('emptyMass', emEl.value);
    b.append('emptyArm', eaEl.value);
    b.append('tripFuel', tripEl.value);
    if (withLoad) {
      document.querySelectorAll('#wb-load input.st').forEach(function (el) { b.append('load[' + el.getAttribute('data-id') + ']', el.value || '0'); });
    }
    var res = await fetch(CALC_URL, { method: 'POST', body: b, credentials: 'same-origin' });
    if (!res.ok) { return null; }
    return res.json();
  }

  function buildTable(stations) {
    var h = '<tr><th class="l">Station</th><th>Eingabe</th><th>Masse</th></tr>';
    for (var i = 0; i < stations.length; i++) {
      var s = stations[i];
      var mx = s.max != null ? ('<br><small>max ' + n1(s.max) + ' ' + s.unit + '</small>') : '';
      h += '<tr><td class="l"><b>' + esc(s.label) + '</b>' + mx + '</td>' +
           '<td><input class="st" type="number" step="0.1" min="0" data-id="' + esc(s.id) + '" value="0"> ' + s.unit + '</td>' +
           '<td class="m-' + i + '"></td></tr>';
    }
    h += '<tr class="sum"><td class="l">Start (Take-off)</td><td></td><td id="wb-tom"></td></tr>';
    document.getElementById('wb-load').innerHTML = h;
    document.querySelectorAll('#wb-load input.st').forEach(function (el) { el.addEventListener('input', schedule); });
  }

  function render(r) {
    // Stationsmassen + Limit-Markierung
    var inputs = document.querySelectorAll('#wb-load input.st');
    for (var i = 0; i < r.stations.length; i++) {
      var cell = document.querySelector('#wb-load .m-' + i);
      if (cell) { cell.textContent = n1(r.stations[i].mass) + ' kg'; }
      if (inputs[i]) { inputs[i].classList.toggle('over', !!r.stations[i].over); }
    }
    var tom = document.getElementById('wb-tom'); if (tom) { tom.textContent = n1(r.to.mass) + ' kg'; }

    document.getElementById('wb-kpi').innerHTML =
      '<div class="k hero"><div class="v">' + n1(r.to.mass) + ' kg</div><div class="t">Startmasse · MTOM ' + n1(r.mtom) + '</div></div>' +
      '<div class="k"><div class="v">' + n1(r.to.cgMm) + ' mm</div><div class="t">Schwerpunkt Start</div></div>' +
      '<div class="k"><div class="v">' + n1(r.ldg.mass) + ' kg</div><div class="t">Landemasse</div></div>';
    document.getElementById('wb-verdict').innerHTML = '<div class="verdict ' + (r.ok ? 'ok' : 'bad') + '">' + (r.ok ? '✓ Innerhalb der Grenzen' : '✕ Grenzen verletzt') + '</div>';
    document.getElementById('wb-warn').innerHTML = (r.warnings || []).map(function (w) { return '<li>⚠ ' + esc(w) + '</li>'; }).join('');
    document.getElementById('wb-env').innerHTML = r.svg || '';
  }

  function schedule() { clearTimeout(timer); timer = setTimeout(function () { post(true).then(function (r) { if (r) { render(r); } }); }, 200); }

  async function selectType() {
    if (!acSel.value) { document.getElementById('wb-body').style.display = 'none'; document.getElementById('wb-empty').style.display = ''; return; }
    var r = await post(false);
    if (!r || r.error) { return; }
    if (r.defaults) { emEl.value = r.defaults.emptyMass != null ? r.defaults.emptyMass : ''; eaEl.value = r.defaults.emptyArm != null ? r.defaults.emptyArm : ''; }
    document.getElementById('wb-src').textContent = r.source ? ('Quelle: ' + r.source) : '';
    buildTable(r.stations);
    document.getElementById('wb-empty').style.display = 'none';
    document.getElementById('wb-body').style.display = '';
    // Nach dem Vorbefuellen der Leerwerte einmal mit aktuellen Eingaben rechnen.
    post(true).then(function (r2) { if (r2) { render(r2); } });
  }

  acSel.addEventListener('change', selectType);
  [emEl, eaEl, tripEl].forEach(function (el) { el.addEventListener('input', schedule); });
})();
</script>
{% endblock %}
