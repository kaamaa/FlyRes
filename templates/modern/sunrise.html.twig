{% extends 'modern/layout.html.twig' %}

{% block ptitle %}Sonnenzeiten (Sunrise / Sunset){% endblock %}

{% block content %}
<style>
  .fr-srss-form{display:flex;flex-wrap:wrap;gap:14px;align-items:flex-end;margin-bottom:14px;}
  .fr-srss-form label{display:block;font-size:11px;font-weight:800;color:var(--fr-blue-d);text-transform:uppercase;letter-spacing:.5px;margin-bottom:4px;}
  .fr-srss-form select,.fr-srss-form input{padding:9px 10px;border:1px solid var(--fr-line,#d8d8d8);border-radius:8px;font:inherit;background:#fff;min-width:220px;}
  .fr-srss-hint{font-size:12px;color:var(--fr-mut);margin:-6px 0 12px;}
  .fr-srss-title{font-weight:700;color:var(--fr-ink);margin:6px 0 12px;line-height:1.5;}
  .fr-srss-wrap{overflow-x:auto;border:1px solid var(--fr-line,#e5e5e5);border-radius:10px;}
  .fr-srss-wrap table{border-collapse:collapse;width:100%;font-size:12.5px;}
  .fr-srss-wrap th,.fr-srss-wrap td{border:1px solid #e6e6e6;padding:4px 8px;white-space:nowrap;text-align:center;}
  .fr-srss-wrap th{background:#eef3f7;color:var(--fr-blue-d);font-weight:700;}
</style>

<div class="fr-srss-hint">Sonnenauf- und -untergang, Dämmerung und Tageslänge je Tag eines Monats für einen Flugplatz – in UTC, MEZ/MESZ und Ortszeit. Nur für Global-Administratoren.</div>

<form id="srssForm" class="fr-srss-form" method="post" action="{{ path('modern_sunrise') }}">
  <div>
    <label for="form_Country_Name">Land</label>
    {{ form_widget(form.Country_Name) }}
  </div>
  <div>
    <label for="form_Airport_Name">Flugplatz</label>
    {{ form_widget(form.Airport_Name) }}
  </div>
  <div>
    <label for="form_SRSSDate">Monat (MM.JJJJ)</label>
    {{ form_widget(form.SRSSDate, {'attr': {'placeholder': 'MM.JJJJ'}}) }}
  </div>
  <div>
    <button type="submit" class="fr-btn">Anzeigen</button>
  </div>
  {{ form_rest(form) }}
</form>

{% if title %}<div class="fr-srss-title">{{ title|raw }}</div>{% endif %}
<div class="fr-srss-wrap">{{ htmlTable|raw }}</div>

<script>
  (function () {
    var f = document.getElementById('srssForm');
    ['form_Country_Name', 'form_Airport_Name', 'form_SRSSDate'].forEach(function (id) {
      var el = document.getElementById(id);
      if (el) { el.addEventListener('change', function () { f.submit(); }); }
    });
  })();
</script>
{% endblock %}
