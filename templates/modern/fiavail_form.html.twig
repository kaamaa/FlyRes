{% extends 'modern/layout.html.twig' %}

{% block ptitle %}{{ isNew ? 'Neue Schulungszeit' : 'Schulungszeit bearbeiten' }}{% endblock %}

{% block content %}
<form class="fr-form" action="{{ path('modern_fiavail_save') }}" method="post">
  <input type="hidden" name="id" value="{{ v.id }}">

  {% if errors %}
    <div class="fr-msg err">{% for e in errors %}<div>{{ e }}</div>{% endfor %}</div>
  {% endif %}

  <div class="fr-formsec">Verfügbarkeit</div>
  <div class="fr-card">
    {% if isAdmin %}
    <div class="fr-frow">
      <label>Fluglehrer</label>
      <div class="fr-ctrl">
        <span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></span>
        <select name="fi">
          {% for label, id in instructors %}<option value="{{ id }}" {{ id == v.fi ? 'selected' : '' }}>{{ label }}</option>{% endfor %}
        </select>
      </div>
    </div>
    {% else %}
      <input type="hidden" name="fi" value="{{ v.fi }}">
    {% endif %}
    <div class="fr-frow">
      <label>Typ</label>
      <div class="fr-ctrl">
        <span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2 4-4"/></svg></span>
        <select name="typ">
          {% for label, id in states %}<option value="{{ id }}" {{ id == v.typ ? 'selected' : '' }}>{{ label }}</option>{% endfor %}
        </select>
      </div>
      <small class="fr-hint">„verfügbar" = direkt buchbar · „auf Anfrage" = erst nach Freigabe · „nicht verfügbar" = blockiert.</small>
    </div>
  </div>

  <div class="fr-formsec">Zeitraum</div>
  <div class="fr-card">
    {% set icCal %}<span class="ic"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg></span>{% endset %}
    {% set icClock %}<span class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>{% endset %}
    <div class="fr-f2">
      <div class="fr-frow"><label>Von · Datum</label><div class="fr-ctrl dt fr-date">{{ icCal|raw }}<span class="fr-datedisp"></span><input type="hidden" name="vondate" value="{{ v.vondate }}"><div class="fr-calpop" hidden></div></div></div>
      <div class="fr-frow"><label>Von · Zeit</label><div class="fr-ctrl dt">{{ icClock|raw }}<input type="time" name="vontime" value="{{ v.vontime }}" step="900"></div></div>
    </div>
    <div class="fr-f2">
      <div class="fr-frow"><label>Bis · Datum</label><div class="fr-ctrl dt fr-date">{{ icCal|raw }}<span class="fr-datedisp"></span><input type="hidden" name="bisdate" value="{{ v.bisdate }}"><div class="fr-calpop" hidden></div></div></div>
      <div class="fr-frow"><label>Bis · Zeit</label><div class="fr-ctrl dt">{{ icClock|raw }}<input type="time" name="bistime" value="{{ v.bistime }}" step="900"></div></div>
    </div>
  </div>

  <div class="fr-formsec">Kommentar</div>
  <div class="fr-card">
    <div class="fr-frow col"><textarea name="comment" class="fr-area" rows="2" placeholder="Optional (z. B. nur Platzrunden)">{{ v.comment }}</textarea></div>
  </div>

  <div class="fr-formfoot">
    <button type="submit" class="fr-btn">Speichern</button>
    <a class="fr-clear" href="{{ path('modern_fiavail') }}">Abbrechen</a>
  </div>
</form>

<script>
(function () {
  var SERVER_TODAY = '{{ today }}';
  function pad2(n) { return (n < 10 ? '0' : '') + n; }
  function setupDate(wrap) {
    var inp = wrap.querySelector('input[type=hidden]'), disp = wrap.querySelector('.fr-datedisp'), pop = wrap.querySelector('.fr-calpop');
    var WD = ['So','Mo','Di','Mi','Do','Fr','Sa'], MON = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'], view = {};
    function fmt(iso) { if (!iso) return 'Bitte wählen…'; var p = iso.split('-'); return WD[new Date(+p[0],+p[1]-1,+p[2]).getDay()] + ' ' + p[2] + '.' + p[1] + '.' + p[0]; }
    function refresh() { disp.textContent = fmt(inp.value); }
    function build() {
      var first = new Date(view.y, view.m-1, 1), lead = (first.getDay()+6)%7, dim = new Date(view.y, view.m, 0).getDate();
      var cells = Math.ceil((lead+dim)/7)*7, start = new Date(view.y, view.m-1, 1-lead);
      var h = '<div class="cal-head"><button type="button" data-nav="-1">‹</button><b>' + MON[view.m-1] + ' ' + view.y + '</b><button type="button" data-nav="1">›</button></div><div class="cal-grid">';
      ['Mo','Di','Mi','Do','Fr','Sa','So'].forEach(function (w) { h += '<span class="cal-wd">' + w + '</span>'; });
      for (var i = 0; i < cells; i++) {
        var dt = new Date(start.getFullYear(), start.getMonth(), start.getDate()+i);
        var iso = dt.getFullYear() + '-' + pad2(dt.getMonth()+1) + '-' + pad2(dt.getDate());
        var c = 'cal-day' + ((dt.getMonth()+1 !== view.m || dt.getFullYear() !== view.y) ? ' out' : '');
        if (iso === inp.value) c += ' sel'; if (iso === SERVER_TODAY) c += ' today';
        h += '<button type="button" class="' + c + '" data-iso="' + iso + '">' + dt.getDate() + '</button>';
      }
      pop.innerHTML = h + '</div>';
    }
    function open() { var p = (inp.value || SERVER_TODAY).split('-'); view = {y:+p[0], m:+p[1]}; build(); pop.hidden = false; }
    function close() { pop.hidden = true; }
    wrap.addEventListener('click', function (e) { if (e.target.closest('.fr-calpop')) return; pop.hidden ? open() : close(); });
    pop.addEventListener('click', function (e) {
      e.stopPropagation();
      var nav = e.target.closest('[data-nav]'); if (nav) { view.m += +nav.dataset.nav; if (view.m<1){view.m=12;view.y--;} if (view.m>12){view.m=1;view.y++;} build(); return; }
      var day = e.target.closest('[data-iso]'); if (day) { inp.value = day.dataset.iso; refresh(); close(); }
    });
    document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) close(); });
    refresh();
    wrap._set = function (iso) { inp.value = iso; refresh(); };
    wrap._inp = inp;
  }
  var dates = Array.prototype.map.call(document.querySelectorAll('.fr-date'), function (w) { setupDate(w); return w; });
  // Von-Datum ändern -> Bis-Datum gleichsetzen, falls Bis leer/davor
  if (dates.length === 2) {
    dates[0].addEventListener('click', function () {
      setTimeout(function () { if (!dates[1]._inp.value || dates[1]._inp.value < dates[0]._inp.value) { dates[1]._set(dates[0]._inp.value); } }, 0);
    });
  }
})();
</script>
{% endblock %}
