{% extends 'modern/layout.html.twig' %}
{% import 'modern/_pagehead.html.twig' as ph %}
{% import 'modern/_icons.html.twig' as icon %}

{% block pagehead %}{% endblock %}

{% block content %}
  <style>
    .fr-note-body h3,.fr-note-body h4,.fr-note-body h5{font-size:14px;margin:9px 0 4px;color:var(--fr-blue-d,#1f4d73);}
    .fr-note-body ul,.fr-note-body ol{margin:6px 0;padding-left:20px;} .fr-note-body li{margin:2px 0;}
    .fr-note-body a{color:var(--fr-blue,#3b6ea5);} .fr-note-body mark{background:#fff3bf;padding:0 2px;border-radius:2px;}
    .fr-note-body p{margin:6px 0;} .fr-note-body p:first-child{margin-top:0;}
  </style>

  {{ ph.tabs([
    {label:'Alle',  icon:'pin',  href: path('modern_notes'),                 active: scope != 'meine'},
    {label:'Meine', icon:'user', href: path('modern_notes', {scope:'meine'}), active: scope == 'meine'}
  ]) }}

  <div class="fr-panel">
    <div class="fr-phead">
      <span class="fr-phspring"></span>
      <a class="fr-btn" href="{{ path('modern_note_new') }}">{{ icon.ic('plus') }} Neuer Eintrag</a>
    </div>
    <div class="fr-pbody">

      <div class="fr-notes">
        {% for n in items %}
          <article class="fr-note">
            <div class="fr-note-pin"></div>
            <header class="fr-note-hd">
              <h3>{{ n.header }}</h3>
              {% if n.validuntil %}
                <span class="fr-note-exp {{ n.soon ? 'soon' : '' }}">
                  {% if n.days is not null and n.days < 0 %}abgelaufen{% elseif n.days == 0 %}läuft heute ab{% else %}bis {{ n.validuntil }}{% endif %}
                </span>
              {% endif %}
            </header>
            <div class="fr-note-body">{{ n.text|note_html }}</div>
            <footer class="fr-note-ft">
              <span class="fr-note-meta">
                <span class="av">{{ n.author|split(' ')|map(p => p|first)|join|slice(0, 2)|upper }}</span>
                {{ n.author }}{% if n.created %} · {{ n.created }}{% endif %}
              </span>
              {% if n.canedit %}
                <span class="fr-note-act">
                  <a class="fr-iconbtn" href="{{ path('modern_note_edit', {id: n.id}) }}" title="Bearbeiten">✎</a>
                  <form method="post" action="{{ path('modern_note_delete') }}" onsubmit="return confirm('Diesen Pinnwandeintrag löschen?');">
                    <input type="hidden" name="id" value="{{ n.id }}">
                    <button type="submit" class="fr-iconbtn del" title="Löschen">🗑</button>
                  </form>
                </span>
              {% endif %}
            </footer>
          </article>
        {% else %}
          <div class="fr-empty">Keine {{ scope == 'meine' ? 'eigenen ' : '' }}Pinnwandeinträge.</div>
        {% endfor %}
      </div>

    </div>
  </div>
{% endblock %}
