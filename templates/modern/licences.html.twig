{% extends 'modern/layout.html.twig' %}

{% block ptitle %}Lizenzen{% endblock %}

{% block topactions %}
  {% if userName %}
    <a class="fr-btn ghost" href="{{ path('modern_licences', {scope: 'alle'}) }}">‹ Alle Lizenzen</a>
    <span class="fr-chip on">🎓 {{ userName }}</span>
    <a class="fr-btn" style="margin-left:auto;" href="{{ path('modern_licence_new', {user: userFilter}) }}">＋ Neue Lizenz</a>
  {% else %}
    <a class="fr-chip {{ scope == 'meine' ? 'on' : '' }}" href="{{ path('modern_licences') }}">Meine</a>
    {% if isAdmin %}
      <a class="fr-chip {{ scope == 'alle' ? 'on' : '' }}" href="{{ path('modern_licences', {scope: 'alle'}) }}">Alle Nutzer</a>
      <a class="fr-chip {{ scope == 'abgelaufen' ? 'on' : '' }}" href="{{ path('modern_licences', {scope: 'abgelaufen'}) }}">Abgelaufen</a>
    {% endif %}
    <a class="fr-btn" style="margin-left:auto;" href="{{ path('modern_licence_new') }}">＋ Neue Lizenz</a>
  {% endif %}
{% endblock %}

{% block content %}
  <div class="fr-kpis">
    <div class="fr-kpi"><span class="dot green"></span><div><div class="v">{{ kpi.green }}</div><div class="k">&gt; 12 Monate gültig</div></div></div>
    <div class="fr-kpi"><span class="dot amber"></span><div><div class="v">{{ kpi.amber }}</div><div class="k">3–12 Monate</div></div></div>
    <div class="fr-kpi"><span class="dot red"></span><div><div class="v">{{ kpi.red }}</div><div class="k">&lt; 3 Monate / abgelaufen</div></div></div>
    <div class="fr-kpi"><span class="dot inf"></span><div><div class="v">{{ kpi.inf }}</div><div class="k">unbegrenzt</div></div></div>
  </div>

  {% for g in groups %}
    <div class="fr-ugrp">
      <div class="fr-uhd">
        <span class="av">{{ g.user|split(' ')|map(p => p|first)|join|slice(0, 2)|upper }}</span>{{ g.user }}
        {% if g.red %}<span class="mini red">● {{ g.red }} unter 3 Monate / abgelaufen</span>
        {% elseif g.amber %}<span class="mini amber">● {{ g.amber }} unter 12 Monate</span>{% endif %}
      </div>
      {% for l in g.items %}
        <a class="fr-lcard" href="{{ path('modern_licence_edit', {id: l.id}) }}">
          <div class="fr-lbar {{ l.state }}"></div>
          <div class="fr-linfo">
            <div class="fr-lname">{{ l.name }}{% if l.fullname %} <span class="full">{{ l.fullname }}</span>{% endif %}</div>
            <div class="fr-lsub">{{ l.validity }}</div>
            {% if l.comment %}<div class="fr-lcomment">{{ l.comment }}</div>{% endif %}
          </div>
          <span class="fr-ltag {{ l.state }}">{{ l.badge }}</span>
          <span class="fr-lchev">›</span>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="fr-empty">Keine Lizenzen{{ scope == 'abgelaufen' ? ' abgelaufen' : '' }}.</div>
  {% endfor %}

  <div class="fr-llegend">
    <span><i class="green"></i>grün: mehr als 12 Monate gültig (oder unbegrenzt)</span>
    <span><i class="amber"></i>gelb: 3–12 Monate gültig</span>
    <span><i class="red"></i>rot: weniger als 3 Monate gültig oder abgelaufen</span>
  </div>
{% endblock %}
