{# ===========================================================================
   Modernes Layout (Variante A, Sidebar) – Vorschau-Scheibe.
   Eigenstaendig (extends NICHT das alte layout.html.twig), damit der Bestand
   unberuehrt bleibt. Laedt ausschliesslich modern.css.
   =========================================================================== #}
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>FlyRes</title>
  <link href="{{ asset('images/css/modern.css') }}?v={{ 'now'|date('YmdHis') }}" rel="stylesheet">
  <script src="{{ asset('images/js/fravail.js') }}?v={{ 'now'|date('YmdHis') }}"></script>
</head>
<body class="fr-modern">
  <div class="fr-app">
    {{ include('modern/_sidebar.html.twig') }}
    <div class="fr-main">
      {# Klassische Titelleiste. Seiten mit Karteireiter-Kopf ueberschreiben den
         Block "pagehead" leer und rendern Reiter+Panel selbst im content. #}
      {% block pagehead %}
      <div class="fr-top">
        <h2 class="fr-ptitle">{% block ptitle %}FlyRes{% endblock %}</h2>
        <div class="fr-topactions">{% block topactions %}{% endblock %}</div>
      </div>
      {% endblock %}
      <div class="fr-body">
        {% block content %}{% endblock %}
      </div>
    </div>
  </div>

  {# Hoehe an eine einbettende Seite melden - siehe modern/_iframeheight.html.twig #}
  {{ include('modern/_iframeheight.html.twig') }}
</body>
</html>
