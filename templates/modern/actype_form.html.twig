{% extends 'modern/layout.html.twig' %}
{% import 'modern/_pagehead.html.twig' as ph %}

{% block pagehead %}{% endblock %}

{% block content %}
  {{ ph.tabs([{label: isNew ? 'Neuer Flugzeugtyp' : 'Flugzeugtyp bearbeiten', icon: 'plane'}]) }}
  <div class="fr-panel">
    <div class="fr-pactions">
      <button type="submit" form="at_form" class="fr-btn">Flugzeugtyp speichern</button>
      <a class="fr-btn" href="{{ path('modern_aircraft', {tab: 'typen'}) }}">Abbrechen</a>
    </div>
    <div class="fr-pbody">
<form id="at_form" class="fr-form" action="{{ path('modern_actype_save') }}" method="post">
  <input type="hidden" name="id" value="{{ v.id }}">

  {% if errors %}
    <div class="fr-msg err">{% for e in errors %}<div>{{ e }}</div>{% endfor %}</div>
  {% endif %}

  <div class="fr-formsec">Flugzeugtyp</div>
  <div class="fr-card">
    <div class="fr-f2">
      <div class="fr-frow">
        <label>Kurzname</label>
        <div class="fr-ctrl">
          <span class="ic"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h8"/></svg></span>
          <input type="text" name="short" value="{{ v.short }}" maxlength="50" placeholder="z. B. C172">
        </div>
      </div>
      <div class="fr-frow">
        <label>Langname</label>
        <div class="fr-ctrl">
          <span class="ic"><svg viewBox="0 0 24 24"><path d="M22 10L12 4 2 10l10 6 10-6z"/><path d="M6 12v5c0 1 3 3 6 3s6-2 6-3v-5"/></svg></span>
          <input type="text" name="long" value="{{ v.long }}" maxlength="100" placeholder="z. B. Cessna 172 Skyhawk">
        </div>
      </div>
    </div>
  </div>

  <div class="fr-formsec">Erforderliche Lizenzen</div>
  <div class="fr-card">
    <div class="fr-checklist">
      {% for l in licenceTypes %}
        <label class="fr-check"><input type="checkbox" name="licencetypes[]" value="{{ l.id }}" {{ l.id in v.licences ? 'checked' : '' }}><span>{{ l.label }}</span></label>
      {% else %}
        <div class="fr-acard-muted">Keine Lizenztypen vorhanden.</div>
      {% endfor %}
    </div>
    <small class="fr-hint">Diese Lizenzen werden beim Buchen dieses Flugzeugtyps geprüft.</small>
  </div>

</form>
    </div>{# fr-pbody #}
  </div>{# fr-panel #}
{% endblock %}
