{# Sidebar-Navigation (Variante A). Buchungs-Ansichten zeigen schon das neue
   Design (modern_bookings + command); Stammdaten/Verwaltung folgen als naechste
   Scheiben und sind hier als "bald" markiert. #}
{% set u = umfang|default('alle') %}
{% set route = app.request.attributes.get('_route') %}
<div class="fr-side">
  <div class="fr-brand"><span>✈</span> FlyRes</div>

  <a class="fr-nav {{ route == 'modern_dashboard' ? 'on' : '' }}" href="{{ path('modern_dashboard') }}"><span class="ic">🏠</span> Dashboard</a>

  <a class="fr-nav {{ route == 'modern_reserve' ? 'on' : '' }}" href="{{ path('modern_reserve') }}"><span class="ic">＋</span> Reservieren</a>

  <div class="fr-navsec">Ansichten</div>
  <a class="fr-nav {{ route == 'modern_bookings' and u == 'alle' ? 'on' : '' }}" href="{{ path('modern_bookings') }}"><span class="ic">📋</span> Alle Buchungen</a>
  <a class="fr-nav {{ route == 'modern_bookings' and u != 'alle' ? 'on' : '' }}" href="{{ path('modern_bookings', {umfang: 'meine'}) }}"><span class="ic">👤</span> Meine Buchungen</a>
  <a class="fr-nav {{ route == 'modern_overview' ? 'on' : '' }}" href="{{ path('modern_overview') }}"><span class="ic">📊</span> Wochenübersicht</a>

  <div class="fr-navsec">Stammdaten</div>
  {% if is_granted('ROLE_SYSTEM_ADMIN') %}
    <a class="fr-nav {{ route starts with 'modern_aircraft' or route starts with 'modern_actype' ? 'on' : '' }}" href="{{ path('modern_aircraft') }}"><span class="ic">🛩️</span> Flugzeuge</a>
  {% else %}
    <span class="fr-nav muted"><span class="ic">🛩️</span> Flugzeuge</span>
  {% endif %}
  <a class="fr-nav {{ route == 'modern_licences' ? 'on' : '' }}" href="{{ path('modern_licences') }}"><span class="ic">🎓</span> Lizenzen</a>
  <a class="fr-nav {{ route starts with 'modern_note' ? 'on' : '' }}" href="{{ path('modern_notes') }}"><span class="ic">📌</span> Pinnwand</a>

  <div class="fr-navsec">Verwaltung</div>
  {% if is_granted('ROLE_SYSTEM_ADMIN') %}
    <a class="fr-nav {{ route starts with 'modern_user' ? 'on' : '' }}" href="{{ path('modern_users') }}"><span class="ic">👥</span> Nutzer</a>
  {% else %}
    <span class="fr-nav muted"><span class="ic">👥</span> Nutzer</span>
  {% endif %}
  {% if is_granted('ROLE_GLOBAL_ADMIN') %}
    <a class="fr-nav {{ route starts with 'modern_mandant' ? 'on' : '' }}" href="{{ path('modern_mandanten') }}"><span class="ic">⚙️</span> Mandanten</a>
  {% else %}
    <span class="fr-nav muted"><span class="ic">⚙️</span> Mandanten</span>
  {% endif %}

  <div class="fr-navsec">Hilfe</div>
  <a class="fr-nav {{ route == 'modern_help' ? 'on' : '' }}" href="{{ path('modern_help') }}"><span class="ic">❓</span> Anleitung</a>

  <div class="fr-usr">
    <span class="ava">{{ (app.user.firstname|default('')|first) ~ (app.user.lastname|default('')|first) }}</span>
    <div>{{ app.user.firstname|default('') }} {{ app.user.lastname|default('') }}<br>
      <span style="color:#7f93a8;font-size:11px;">Vorschau · Variante A</span>
    </div>
  </div>
</div>
