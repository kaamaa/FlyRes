{# Sidebar-Navigation (Variante A). Gruppierung nach Datentyp, einheitliche
   monochrome Linien-Icons. Admin-Eintraege werden fuer Nicht-Berechtigte
   komplett ausgeblendet (nicht ausgegraut); leere Gruppen entfallen. #}
{% import _self as ui %}
{% macro ic(name) %}
{%- set p = {
  'home':    '<path d="M3 9.5 12 3l9 6.5"/><path d="M5 10v10h5v-6h4v6h5V10"/>',
  'plus':    '<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>',
  'chart':   '<line x1="6" y1="20" x2="6" y2="12"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="18" y1="20" x2="18" y2="9"/>',
  'user':    '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
  'list':    '<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="3.5" cy="6" r=".7"/><circle cx="3.5" cy="12" r=".7"/><circle cx="3.5" cy="18" r=".7"/>',
  'clock':   '<circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/>',
  'plane':   '<path d="M21 15.5 13.5 11V4.2a1.5 1.5 0 0 0-3 0V11L3 15.5V17l7.5-2.3V19l-2 1.4V22l3.5-1 3.5 1v-1.6L13.5 19v-4.3L21 17z"/>',
  'award':   '<circle cx="12" cy="8" r="6"/><path d="M8.2 13.2 7 22l5-3 5 3-1.2-8.8"/>',
  'pin':     '<path d="M12 17v5"/><path d="M9 10.8a2 2 0 0 1-1.1 1.8l-1.8.9A2 2 0 0 0 5 15.2V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.8a2 2 0 0 0-1.1-1.7l-1.8-.9A2 2 0 0 1 15 10.8V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"/>',
  'users':   '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.9"/><path d="M16 3.1a4 4 0 0 1 0 7.8"/>',
  'building':'<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01M16 6h.01M8 10h.01M16 10h.01M8 14h.01M16 14h.01"/>',
  'help':    '<circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
  'diag':    '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
  'logout':  '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>'
} -%}
<span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">{{ p[name]|raw }}</svg></span>
{%- endmacro %}

{% set u = umfang|default('alle') %}
{% set route = app.request.attributes.get('_route') %}
<div class="fr-side">
  <div class="fr-brand"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15.5 13.5 11V4.2a1.5 1.5 0 0 0-3 0V11L3 15.5V17l7.5-2.3V19l-2 1.4V22l3.5-1 3.5 1v-1.6L13.5 19v-4.3L21 17z"/></svg> FlyRes</div>

  <a class="fr-nav {{ route == 'modern_dashboard' ? 'on' : '' }}" href="{{ path('modern_dashboard') }}">{{ ui.ic('home') }} Dashboard</a>
  <a class="fr-nav {{ route == 'modern_reserve' ? 'on' : '' }}" href="{{ path('modern_reserve') }}">{{ ui.ic('plus') }} Reservieren</a>

  <div class="fr-navsec">Ansichten</div>
  <a class="fr-nav {{ route == 'modern_overview' ? 'on' : '' }}" href="{{ path('modern_overview') }}">{{ ui.ic('chart') }} Übersichten</a>
  <a class="fr-nav {{ route == 'modern_bookings' and u != 'alle' ? 'on' : '' }}" href="{{ path('modern_bookings', {umfang: 'meine'}) }}">{{ ui.ic('user') }} Meine Buchungen</a>
  <a class="fr-nav {{ route == 'modern_bookings' and u == 'alle' ? 'on' : '' }}" href="{{ path('modern_bookings') }}">{{ ui.ic('list') }} Alle Buchungen</a>
  {% if is_granted('ROLE_FI') %}
    <a class="fr-nav {{ route starts with 'modern_fiavail' ? 'on' : '' }}" href="{{ path('modern_fiavail') }}">{{ ui.ic('clock') }} Schulungszeiten</a>
  {% endif %}

  <div class="fr-navsec">Stammdaten</div>
  {% if is_granted('ROLE_SYSTEM_ADMIN') %}
    <a class="fr-nav {{ route starts with 'modern_aircraft' or route starts with 'modern_actype' ? 'on' : '' }}" href="{{ path('modern_aircraft') }}">{{ ui.ic('plane') }} Flugzeuge</a>
  {% endif %}
  <a class="fr-nav {{ route == 'modern_licences' ? 'on' : '' }}" href="{{ path('modern_licences') }}">{{ ui.ic('award') }} Lizenzen</a>
  <a class="fr-nav {{ route starts with 'modern_note' ? 'on' : '' }}" href="{{ path('modern_notes') }}">{{ ui.ic('pin') }} Pinnwand</a>

  {% if is_granted('ROLE_SYSTEM_ADMIN') %}
  <div class="fr-navsec">Administration</div>
    <a class="fr-nav {{ route starts with 'modern_user' ? 'on' : '' }}" href="{{ path('modern_users') }}">{{ ui.ic('users') }} Nutzer</a>
    {% if is_granted('ROLE_GLOBAL_ADMIN') %}
      <a class="fr-nav {{ route starts with 'modern_mandant' ? 'on' : '' }}" href="{{ path('modern_mandanten') }}">{{ ui.ic('building') }} Mandanten</a>
    {% endif %}
    <a class="fr-nav {{ route starts with 'modern_system' ? 'on' : '' }}" href="{{ path('modern_system') }}">{{ ui.ic('diag') }} Diagnose</a>
  {% endif %}

  <div class="fr-navsep"></div>
  <a class="fr-nav {{ route == 'modern_help' ? 'on' : '' }}" href="{{ path('modern_help') }}">{{ ui.ic('help') }} Anleitung</a>

  {% set rolle = 'Pilot' %}
  {% if is_granted('ROLE_GLOBAL_ADMIN') %}{% set rolle = 'Global-Administrator' %}
  {% elseif is_granted('ROLE_SYSTEM_ADMIN') %}{% set rolle = 'System-Administrator' %}
  {% elseif is_granted('ROLE_ADMIN') %}{% set rolle = 'Administrator' %}
  {% elseif is_granted('ROLE_FI') %}{% set rolle = 'Fluglehrer' %}{% endif %}
  <div class="fr-usr">
    <span class="ava">{{ (app.user.firstname|default('')|first) ~ (app.user.lastname|default('')|first) }}</span>
    <div>{{ app.user.firstname|default('') }} {{ app.user.lastname|default('') }}<br>
      <span style="color:#7f93a8;font-size:11px;">{{ rolle }}</span>
    </div>
    <a class="fr-logout" href="{{ path('app_logout') }}" title="Abmelden">{{ ui.ic('logout') }}</a>
  </div>
  <div style="text-align:center;font-size:10.5px;color:#7f93a8;padding:6px 0 2px;">FlyRes v{{ app_version }}</div>
</div>
