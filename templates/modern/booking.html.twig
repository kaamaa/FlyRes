{% extends 'modern/layout.html.twig' %}

{% block ptitle %}Buchungsdetails{% endblock %}

{% block topactions %}
  <a class="fr-btn ghost" href="javascript:history.back()">‹ Zurück</a>
  {% if editable %}<a class="fr-btn ghost" style="margin-left:auto;" href="{{ path('modern_booking_edit', {id: id}) }}">Bearbeiten</a>{% endif %}
  {% if modify %}<button type="button" class="fr-btn danger" id="b_cancel" data-id="{{ id }}" {% if not editable %}style="margin-left:auto;"{% endif %}>Stornieren</button>{% endif %}
{% endblock %}

{% block content %}
  {# MVP 2: Platzhalter "Fluglehrer zuweisen" -> Fluglehrer noch offen #}
  {% set fiOpen = 'fluglehrer' in (flightinstructor|default('')|lower) %}
  <div class="fr-detail">
    <div class="fr-kv full"><span class="k">Zeitraum</span><span class="v">{{ start }} – {{ end }}</span></div>
    <div class="fr-kv"><span class="k">Flugzeug</span><span class="v">{{ flugzeug }}</span></div>
    <div class="fr-kv"><span class="k">Flugzweck</span><span class="v">{{ flightpurpose }}</span></div>
    <div class="fr-kv"><span class="k">Pilot</span><span class="v">{{ ReservedForUser }}</span></div>
    <div class="fr-kv"><span class="k">Fluglehrer</span><span class="v">{% if fiOpen %}<b style="color:#c9781a">⚠ noch offen – bitte selbst organisieren</b>{% else %}{{ flightinstructor ?: '—' }}{% endif %}</span></div>
    <div class="fr-kv"><span class="k">Flugplatz</span><span class="v">{{ airfield }}</span></div>
    <div class="fr-kv"><span class="k">Kontakt</span><span class="v">{{ telmobile ?: telhome ?: teloffice ?: '—' }}</span></div>
    <div class="fr-kv full"><span class="k">Beschreibung</span><span class="v">{{ description ?: '—' }}</span></div>
  </div>

  {% if fiOpen %}
  <div style="margin-top:14px;background:#fff6e9;border:1px solid #f0d59a;border-radius:12px;padding:14px 15px;">
    <div style="color:#7a4f08;font-weight:800;">Diese Buchung hat noch keinen echten Fluglehrer.</div>
    <div style="color:#8a5d0e;font-size:13.5px;margin-top:3px;line-height:1.5;">„Fluglehrer offen" ist nur ein Platzhalter. Bitte such dir selbst einen Fluglehrer und trage ihn ein – sonst kann der Flug nicht stattfinden.</div>
    <div style="display:flex;gap:9px;flex-wrap:wrap;margin-top:12px;">
      <a class="fr-btn" href="{{ path('modern_fiweek') }}" style="background:#c9781a;border-color:#c9781a;">Verfügbare Fluglehrer anzeigen</a>
      {% if editable %}<a class="fr-btn ghost" href="{{ path('modern_booking_edit', {id: id}) }}">Fluglehrer eintragen</a>{% endif %}
    </div>
  </div>
  {% endif %}

  <div id="b_msg" class="fr-msg" hidden></div>

  <div class="fr-detmeta">
    Reserviert von {{ ReservedForUser }} am {{ ReservedAt }}{% if ChangedAt %} · zuletzt geändert am {{ ChangedAt }}{% endif %}
  </div>

  {% if modify %}
  <script>
  (function () {
    var btn = document.getElementById('b_cancel'), msg = document.getElementById('b_msg');
    if (!btn) return;
    btn.addEventListener('click', function () {
      if (!confirm('Diese Buchung wirklich stornieren? Die beteiligten Personen werden per E-Mail informiert.')) return;
      btn.disabled = true; btn.textContent = 'Storniere…'; msg.hidden = true;
      fetch('/api/bookings/' + btn.dataset.id, {
        method: 'DELETE', credentials: 'same-origin', headers: { 'Accept': 'application/json' }
      })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }, function () { return { ok: r.ok, j: null }; }); })
        .then(function (res) {
          if (res.ok && res.j && res.j.success) { window.location.href = '/web/buchungen'; return; }
          btn.disabled = false; btn.textContent = 'Stornieren';
          var e = (res.j && res.j.error) || 'Stornierung fehlgeschlagen.';
          msg.className = 'fr-msg err'; msg.textContent = 'Stornierung nicht möglich: ' + e; msg.hidden = false;
        })
        .catch(function () {
          btn.disabled = false; btn.textContent = 'Stornieren';
          msg.className = 'fr-msg err'; msg.textContent = 'Netzwerkfehler bei der Stornierung.'; msg.hidden = false;
        });
    });
  })();
  </script>
  {% endif %}
{% endblock %}
